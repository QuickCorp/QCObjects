{
  "extends": [
    "./tsconfig.json"
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "outFile": "build/index.d.ts",
    "baseUrl": ".",
    "paths": {
      "types/*": ["types/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "types": [
      "node"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/**/*",
    "types/**/*"
  ],
  "exclude": ["src/**/*.mts", "src/**/*.cts"]
}
